; SPDX-License-Identifier: MPL-2.0
; AgentSkin NSIS installer — branded MUI2 wizard with nsDialogs custom pages,
; real-time detail log, and file log.
; Included by electron-builder via nsis.include in electron-builder.yml
;
; Brand palette lives in scripts/branding.config.mjs (single source of truth).
; It is consumed by scripts/generate-nsis-assets.mjs, which emits build/brand.nsh
; (included above via `!include "brand.nsh"`). Do not hardcode palette values here.

!ifndef AGENTSKIN_INSTALLER_LOG_INCLUDED
!define AGENTSKIN_INSTALLER_LOG_INCLUDED

; Brand palette is sourced from build/brand.nsh (auto-generated by
; scripts/generate-nsis-assets.mjs from scripts/branding.config.mjs).
!include "brand.nsh"

; --- Show real-time details list ---
ShowInstDetails show
ShowUninstDetails show

; --- Log file location (persists across uninstall) ---
!define LOG_DIR "$LOCALAPPDATA\AgentSkin"
!define LOG_FILE "${LOG_DIR}\installer.log"

; --- Timestamp helper (saves/restores registers, result in $R9) ---
!macro TimeStamp
  ClearErrors
  Push $0
  Push $1
  Push $2
  Push $3
  Push $4
  Push $5
  Push $6
  System::Alloc 16
  Pop $0
  System::Call 'kernel32::GetLocalTime(ir0)'
  System::Call '*$0(&i2 .r1, &i2 .r2, &i2 .r3, &i2 .r4, &i2 .r5, &i2 .r6, &i2 .r7, &i2 .r8)'
  System::Free $0
  StrCpy $R9 "$1-$2-$3 $4:$5:$6"
  Pop $6
  Pop $5
  Pop $4
  Pop $3
  Pop $2
  Pop $1
  Pop $0
!macroend

; --- Primary log entry (section header) ---
!macro LogMessage MSG
  ClearErrors
  CreateDirectory "${LOG_DIR}"
  FileOpen $9 "${LOG_FILE}" a
  FileSeek $9 0 END
  Push $R9
  !insertmacro TimeStamp
  FileWrite $9 "[AgentSkin] [$R9] ${MSG}$\r$\n"
  Pop $R9
  FileClose $9
!macroend

; --- Detail log entry (indented sub-item) ---
!macro LogDetail MSG
  ClearErrors
  CreateDirectory "${LOG_DIR}"
  FileOpen $9 "${LOG_FILE}" a
  FileSeek $9 0 END
  FileWrite $9 "    ${MSG}$\r$\n"
  FileClose $9
!macroend

; --- Print to both UI details list AND log file ---
!macro PrintDetail MSG
  DetailPrint "${MSG}"
  !insertmacro LogDetail "${MSG}"
!macroend

; ============================================================
; ROUNDED CORNERS
; ============================================================

!macro ApplyRoundedCorners HWND RADIUS
  ClearErrors
  System::Alloc 16
  Pop $0
  System::Call 'user32::GetWindowRect(p ${HWND}, p r0)'
  System::Call '*$0(i .r1, i .r2, i .r3, i .r4)'
  System::Free $0
  IntOp $5 $3 - $1
  IntOp $6 $4 - $2
  System::Call 'gdi32::CreateRoundRectRgn(i 0, i 0, i r5, i r6, i ${RADIUS}, i ${RADIUS}) p .r7'
  System::Call 'user32::SetWindowRgn(p ${HWND}, p r7, i 1)'
!macroend

; ============================================================
; BRAND COLOR CONSTANTS
; Defined in build/brand.nsh (generated from scripts/branding.config.mjs).
; ============================================================

; ============================================================
; INSTALLER HOOKS (electron-builder macro injection points)
; ============================================================

; ============================================================
; OVERRIDE electron-builder's app-running check
; The default _CHECK_APP_RUNNING (allowOnlyOneInstallerInstance.nsh) pops
; "appCannotBeClosed" and STALLS the install (Retry does nothing) when
; Stop-Process can't kill a cross-session / protected process, or when the
; detection mis-reports — even though the user already closed the app.
; We replace it: force-kill anything still running under $INSTDIR via
; PowerShell, then proceed WITHOUT the blocking dialog.
; ============================================================
!macro customCheckAppRunning
  Push $0
  nsExec::Exec `"$PowerShellPath" -C "Get-CimInstance -ClassName Win32_Process | ? {$$_.Path -and $$_.Path.StartsWith('$INSTDIR','CurrentCultureIgnoreCase')} | % { Stop-Process -Id $$_.ProcessId -Force -ErrorAction SilentlyContinue }"`
  Pop $0
  Sleep 2000
  Pop $0
!macroend

; ============================================================
; PRE-INSTALL KILL PAGE (installer only, not uninstaller)
; ============================================================
; electron-builder's assistedInstaller.nsh calls customPageAfterChangeDir
; right after the directory page and before MUI_PAGE_INSTFILES. We insert
; an invisible custom page here that kills AgentSkin one final time,
; minimizing the window between kill and uninstallOldVersion (which shows
; the "AgentSkin 无法关闭" dialog if the old uninstaller can't clean up).
; The page immediately calls Abort to skip itself -- user never sees it.
; Wrapped in BUILD_UNINSTALLER guard: Page custom is invalid in uninstaller
; context and NSIS treats the unreferenced function as a fatal warning.

!ifndef BUILD_UNINSTALLER
!macro customPageAfterChangeDir
  Page custom agentskinPreInstallKill "" ""
!macroend

Function agentskinPreInstallKill
  Push $0
  nsExec::Exec 'taskkill /F /IM AgentSkin.exe /T'
  Pop $0
  nsExec::Exec 'taskkill /F /IM electron.exe /T'
  Pop $0
  Sleep 1500
  nsExec::Exec 'taskkill /F /IM AgentSkin.exe /T'
  Pop $0
  Sleep 500
  Pop $0
  Abort  ; skip this invisible page, proceed to instfiles
FunctionEnd
!endif ; BUILD_UNINSTALLER

!macro customInit
  ; First-pass kill in .onInit (early, before welcome/directory pages).
  ; The final kill happens in agentskinPreInstallKill right before instfiles.
  ; /T kills the entire process tree (renderer, GPU, utility child processes).
  ; NOTE: nsProcess plugin is NOT available in electron-builder's NSIS env,
  ; so we rely on taskkill + sleep instead of FindProcess verification.
  Push $0
  Push $1

  nsExec::Exec 'taskkill /F /IM AgentSkin.exe /T'
  Pop $0
  nsExec::Exec 'taskkill /F /IM electron.exe /T'
  Pop $0
  Sleep 1000

  ; Second pass - catches processes that survived the first kill
  nsExec::Exec 'taskkill /F /IM AgentSkin.exe /T'
  Pop $0
  Sleep 500

  DetailPrint "已关闭运行中的 AgentSkin 进程"

  ReadEnvStr $R0 "USERNAME"

  !insertmacro LogMessage "=== Install started ==="
  !insertmacro LogDetail "Product: ${PRODUCT_NAME} v${VERSION}"
  !insertmacro LogDetail "Installer file: $EXEFILE"
  !insertmacro LogDetail "User: $R0"
  !insertmacro LogDetail "Windows: $WINDIR"

  DetailPrint "=== AgentSkin ${VERSION} ==="
  DetailPrint "安装程序: $EXEFILE"
  DetailPrint "用户: $R0"

  ; Detect previous installation.
  ; CRITICAL BUG (fixed 2026-07-25): electron-builder registers the install
  ; under INSTALL_REGISTRY_KEY = "Software\<guid>" (UNINSTALL_APP_KEY), NOT
  ; under "...\Uninstall\${APP_ID}". The previous code read the appId key,
  ; which is NEVER written, so detection returned "" and the cleanup was
  ; silently SKIPPED. That let uninstallOldVersion launch the OLD uninstaller
  ; (which ships the stock "appCannotBeClosed" / 请关闭后再重试 retry dialog).
  ; Read the REAL key electron-builder actually uses; probe HKCU then HKLM so
  ; a per-machine old install is still detected (best-effort cleanup).
  StrCpy $1 ""
  ReadRegStr $0 HKCU "${INSTALL_REGISTRY_KEY}" "InstallLocation"
  ${If} $0 == ""
    ReadRegStr $0 HKLM "${INSTALL_REGISTRY_KEY}" "InstallLocation"
  ${EndIf}
  ${If} $0 != ""
    StrCpy $1 $0   ; preserve install location before taskkill clobbers $0
  ${EndIf}

  ${If} $1 != ""
    !insertmacro LogDetail "Previous install detected at: $1"
    DetailPrint "检测到旧版本: $1"
    ; --- Upgrade hardening -------------------------------------------------
    ; The stock electron-builder upgrade flow invokes the OLD uninstaller.exe
    ; to remove the previous version. That old uninstaller ships the stock
    ; "app running" check, which stalls the install with the
    ; "appCannotBeClosed" (请关闭后再重试) dialog — Retry loops forever even
    ; when no process exists. We neutralise that path by force-removing the
    ; previous install ourselves here (in .onInit, BEFORE the install
    ; section's uninstallOldVersion runs). After this, the new installer sees
    ; no previous version and proceeds as a clean fresh install — never
    ; calling the broken old uninstaller.
    nsExec::Exec 'taskkill /F /IM AgentSkin.exe /T'
    Pop $0
    Sleep 500
    RMDir /r "$1"
    ; Drop BOTH registry keys electron-builder writes for an install:
    ;   INSTALL_REGISTRY_KEY   = Software\<guid>            (holds InstallLocation)
    ;   UNINSTALL_REGISTRY_KEY = Software\...\Uninstall\<guid> (holds UninstallString)
    ; uninstallOldVersion reads UNINSTALL_REGISTRY_KEY (then _2); deleting both
    ; makes it find no UninstallString and SKIP the old uninstaller entirely.
    DeleteRegKey HKCU "${INSTALL_REGISTRY_KEY}"
    DeleteRegKey HKLM "${INSTALL_REGISTRY_KEY}"
    DeleteRegKey HKCU "${UNINSTALL_REGISTRY_KEY}"
    DeleteRegKey HKLM "${UNINSTALL_REGISTRY_KEY}"
    !ifdef UNINSTALL_REGISTRY_KEY_2
      DeleteRegKey HKCU "${UNINSTALL_REGISTRY_KEY_2}"
      DeleteRegKey HKLM "${UNINSTALL_REGISTRY_KEY_2}"
    !endif
    ; Legacy appId-keyed entries (never written by electron-builder; harmless).
    DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_ID}"
    DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_ID}"
    !insertmacro LogDetail "Removed previous install (forced clean) at: $1"
    DetailPrint "已强制清理旧版本，将以全新安装继续"
  ${Else}
    !insertmacro LogDetail "Fresh install (no previous version found)"
    DetailPrint "全新安装"
  ${EndIf}

  Pop $1
  Pop $0
!macroend

!macro customInstall
  !insertmacro ApplyRoundedCorners $HWNDPARENT 16

  !insertmacro LogMessage "Files extracted"
  !insertmacro LogDetail "Install directory: $INSTDIR"
  !insertmacro PrintDetail "--- 正在解压应用文件 ---"
  DetailPrint "目标目录: $INSTDIR"

  ; Count installed files
  FindFirst $0 $1 "$INSTDIR\*.*"
  StrCpy $2 0
  ${Do}
    FindNext $0 $1
    ${If} $1 == ""
      ${ExitDo}
    ${EndIf}
    IntOp $2 $2 + 1
  ${Loop}
  FindClose $0
  DetailPrint "安装目录文件数: $2"
  !insertmacro LogDetail "Top-level items: $2"

  !insertmacro PrintDetail "--- 写入注册表 (HKCU) ---"
  !insertmacro LogDetail "Writing uninstall registry keys (HKCU)"

  !insertmacro PrintDetail "--- 创建快捷方式 ---"
  !insertmacro LogDetail "Creating desktop + start menu shortcuts"

  !insertmacro PrintDetail "--- 注册文件关联 ---"
  DetailPrint ".agenttheme  .agentskin-theme  .codedrobe-theme  .codex-theme"
  !insertmacro LogDetail "Registering: .agenttheme .agentskin-theme .codedrobe-theme .codex-theme"

  DetailPrint ""
  DetailPrint "=== 安装完成 ==="
  !insertmacro LogMessage "=== Install completed OK ==="
  !insertmacro LogDetail "-------------------------------------------"
!macroend

!macro customInstallMode
  DetailPrint "安装模式: 当前用户（无需管理员权限）"
  !insertmacro LogDetail "Install mode: per-user (HKCU, no admin required)"
!macroend

; ============================================================
; UNINSTALLER HOOKS
; ============================================================

!macro customUnInit
  ReadEnvStr $R0 "USERNAME"
  !insertmacro LogMessage "=== Uninstall started ==="
  !insertmacro LogDetail "Product: ${PRODUCT_NAME} v${VERSION}"
  !insertmacro LogDetail "Uninstalling from: $INSTDIR"
  !insertmacro LogDetail "User: $R0"

  DetailPrint "=== 卸载 AgentSkin ${VERSION} ==="
  DetailPrint "来源: $INSTDIR"
!macroend

!macro customUnInstall
  !insertmacro ApplyRoundedCorners $HWNDPARENT 16

  !insertmacro PrintDetail "--- 正在移除应用文件 ---"
  !insertmacro LogDetail "Removing application files"

  !insertmacro PrintDetail "--- 正在移除注册表项 ---"
  !insertmacro LogDetail "Removing registry keys"

  !insertmacro PrintDetail "--- 正在移除快捷方式 ---"
  !insertmacro LogDetail "Removing desktop + start menu shortcuts"

  !insertmacro PrintDetail "--- 正在移除文件关联 ---"
  !insertmacro LogDetail "Removing file associations"

  DetailPrint ""
  DetailPrint "=== 卸载完成 ==="
  !insertmacro LogMessage "=== Uninstall completed ==="
  !insertmacro LogDetail "-------------------------------------------"
!macroend

!endif ; AGENTSKIN_INSTALLER_LOG_INCLUDED

; ============================================================
; BRAND-THEMED MUI2 WIZARD
;
; The MUI welcome/finish pages defined here use the standard
; MUI layout with branded colors and bilingual text.
; electron-builder inserts MUI_LANGUAGE after this include.
;
; Language selection is automatic: NSIS detects the system
; locale and selects the matching MUI_LANGUAGE table.
; ============================================================

; --- Window background / text (colors from build/brand.nsh) ---
!define MUI_FONT 'Segoe UI'
!define MUI_FONT_TITLE 'Segoe UI Bold'

; --- Installer welcome page ---
!define MUI_WELCOMEPAGE_TITLE "安装 AgentSkin"
!define MUI_WELCOMEPAGE_TEXT "AgentSkin 是 AI 编程助手的外观管理平台。$\r$\n$\r$\n支持 TRAE、Qoder、WorkBuddy 和豆包，内置 18+ 精选主题。$\r$\n$\r$\n点击「下一步」继续。"
; MUI_WELCOMEFINISHPAGE_BITMAP is auto-defined by electron-builder from
; electron-builder.yml (nsis.installerSidebar) — redefining here causes
; "already defined" NSIS compile errors.
!define MUI_WELCOMEFINISHPAGE_BITMAP_STRETCH NoStretchNoCropNoAlign

; --- Installer directory page ---
!define MUI_DIRECTORYPAGE_TEXT_TOP "选择 AgentSkin 的安装目录。$\r$\n$\r$\n点击「安装」开始。"

; --- Installer finish page ---
!define MUI_FINISHPAGE_TITLE "安装完成"
!define MUI_FINISHPAGE_TEXT "AgentSkin ${VERSION} 已成功安装。$\r$\n$\r$\n启动支持的 AI 编程工具后，主题将自动生效。"
!define MUI_FINISHPAGE_RUN_TEXT "启动 AgentSkin"

; --- Uninstaller pages ---
!define MUI_UNWELCOMEPAGE_TITLE "卸载 AgentSkin"
!define MUI_UNWELCOMEPAGE_TEXT "即将从您的电脑中移除 AgentSkin 及其所有组件。$\r$\n$\r$\n您的主题和设置将保留在 %LOCALAPPDATA%\AgentSkin 中。"
!define MUI_UNFINISHPAGE_TITLE "卸载完成"
!define MUI_UNFINISHPAGE_TEXT "AgentSkin 已成功移除。$\r$\n$\r$\n%LOCALAPPDATA%\AgentSkin\themes 中的主题文件已保留。"

; --- Abort warnings ---
!define MUI_ABORTWARNING_TEXT "确定要退出 AgentSkin 安装吗？"
!define MUI_UNABORTWARNING_TEXT "确定要退出 AgentSkin 卸载吗？"

; --- Icons + header bitmap ---
; MUI_ICON, MUI_UNICON, MUI_HEADERIMAGE, MUI_HEADERIMAGE_BITMAP, and
; MUI_HEADERIMAGE_RIGHT are auto-defined by electron-builder from
; electron-builder.yml (nsis.installerIcon/uninstallerIcon/installerHeader).
; MUI_HEADERIMAGE_UNBITMAP is omitted — MUI2 automatically falls back to
; MUI_HEADERIMAGE_BITMAP for the uninstaller's top-right banner.

; --- Uninstaller sidebar bitmap ---
; MUI_UNWELCOMEFINISHPAGE_BITMAP is auto-defined by electron-builder from
; electron-builder.yml (nsis.uninstallerSidebar).
!define MUI_UNWELCOMEFINISHPAGE_BITMAP_STRETCH NoStretchNoCropNoAlign
