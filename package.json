{
  "name": "agentskin-desktop",
  "productName": "AgentSkin",
  "version": "1.0.0",
  "description": "Agent theme management platform for domestic AI coding tools and extensible desktop agents.",
  "author": "AgentSkin",
  "license": "MPL-2.0",
  "main": "out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "icons": "node scripts/generate-desktop-icons.mjs",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "package": "cross-env ELECTRON_BUILDER_OUT_DIR=out/make/dist electron-vite build && electron-builder --config electron-builder.yml --win --x64 --dir --publish never",
    "package:mac": "cross-env ELECTRON_BUILDER_OUT_DIR=out/make/dist electron-vite build && electron-builder --config electron-builder.yml --mac --arm64 --publish never",
    "package:win": "cross-env ELECTRON_BUILDER_OUT_DIR=out/make/dist electron-vite build && electron-builder --config electron-builder.yml --win --x64 --dir --publish never",
    "build:installer": "build.bat",
    "build:installer:min": "build.bat",
    "build:installer:maj": "build.bat",
    "build:installer:nobump": "build.bat",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "check:contract": "node scripts/check-injection-contract.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "check:theme-staleness": "node scripts/build-palette.mjs --verify && node scripts/generate-theme-css.mjs --verify",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:contract && npm run check:themes && npm run check:theme-staleness && npm run check:architecture",
    "generate:palette": "node scripts/build-palette.mjs",
    "generate:theme-css": "node scripts/generate-theme-css.mjs",
    "generate:themes": "npm run generate:palette && npm run generate:theme-css",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "src/**/*.css": [
      "biome format --write"
    ],
    "scripts/**/*.mjs": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "themes/**": [
      "node scripts/check-themes.mjs"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@radix-ui/colors": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "shadcn": "^4.15.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
