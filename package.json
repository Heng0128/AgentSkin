{
  "name": "agentskin-desktop",
  "productName": "AgentSkin",
  "version": "1.0.0",
  "description": "Agent theme management platform for domestic AI coding tools and extensible desktop agents.",
  "author": "AgentSkin",
  "license": "MPL-2.0",
  "main": "out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "src/**/*.css": [
      "biome format --write"
    ],
    "scripts/**/*.mjs": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "themes/**": [
      "node scripts/check-themes.mjs"
    ],
    "docs/**/*.md": []
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview --skipBuild",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "design-tokens": "node scripts/check-design-tokens.mjs",
    "check": "node scripts/check-suite.mjs",
    "check:fast": "biome check src/ && tsc --noEmit && node scripts/check-design-tokens.mjs && node scripts/check-i18n.mjs",
    "check:defect-doc": "node scripts/generate-defect-fixes-doc.mjs --verify",
    "package": "electron-builder --win --x64 --publish never",
    "package:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@adobe/leonardo-contrast-colors": "^1.1.0",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/colors": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colorthief": "^3.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.18.0",
    "yauzl": "^3.1.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
