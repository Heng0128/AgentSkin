{
  "name": "agentskin-desktop",
  "productName": "AgentSkin",
  "version": "5.3.0",
  "description": "Agent theme management platform for domestic AI coding tools and extensible desktop agents.",
  "author": "AgentSkin",
  "license": "MPL-2.0",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "icons": "node scripts/generate-desktop-icons.mjs",
    "icons:nsis": "node scripts/generate-nsis-assets.mjs",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run icons:nsis && node scripts/verify-nsis-assets.mjs && set ELECTRON_BUILDER_OUT_DIR=out/make/dist&& electron-vite build && electron-builder --config electron-builder.yml --win --x64",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:contract": "node scripts/check-injection-contract.mjs",
    "check:theme-staleness": "node scripts/build-palette.mjs --verify && node scripts/generate-theme-css.mjs --verify",
    "check": "npm run typecheck && npm run test && npm run check:contract && npm run check:theme-staleness",
    "generate:palette": "node scripts/build-palette.mjs",
    "generate:theme-css": "node scripts/generate-theme-css.mjs",
    "generate:themes": "npm run generate:palette && npm run generate:theme-css"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
