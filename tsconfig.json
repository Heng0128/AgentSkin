{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "@/*": ["./src/ui/*"],
      "@shared/*": ["./src/shared/*"],
      "@agentskin/engine": ["./src/engine"]
    }
  },
  "include": ["src", "electron.vite.config.ts"],
  "exclude": ["installer", "out", ".build-tmp", "node_modules"]
}
