{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "id": "sakura-noir",
  "name": "Sakura Noir",
  "displayName": "夜樱",
  "version": "1.0.0",
  "description": "夜里亮灯的樱花树——深色夜幕上落着一层绯粉。与樱花粉彩互为昼夜。",
  "author": {
    "name": "AgentSkin Team",
    "url": "https://github.com/Heng0128/AgentSkin"
  },
  "mode": "dark",
  "category": "professional",
  "tags": [
    "dark",
    "pink",
    "elegant"
  ],
  "icon": "icon.png",
  "preview": "preview.png",
  "hero": "hero.webp",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ],
        "recommended": [
          {
            "name": "task-sidebar",
            "any": [
              ".task-list-base",
              ".task-list-panel"
            ]
          },
          {
            "name": "composer",
            "any": [
              ".chat-input-v2-input-box-editable[contenteditable='true']"
            ]
          }
        ]
      }
    },
    "qoderwork": {
      "css": "assets/css/qoderwork.css",
      "verification": {
        "required": [
          {
            "name": "agents-root",
            "any": [
              ".agents-layout-root"
            ]
          }
        ],
        "recommended": [
          {
            "name": "sidebar",
            "any": [
              ".agents-sidebar",
              "[data-resizable-sidebar]"
            ]
          },
          {
            "name": "workspace",
            "any": [
              ".agents-content-area",
              ".agents-layout-body"
            ]
          },
          {
            "name": "composer",
            "any": [
              ".chat-input-editor-text[contenteditable='true']"
            ]
          }
        ]
      }
    },
    "workbuddy": {
      "css": "assets/css/workbuddy.css",
      "verification": {
        "required": [
          {
            "name": "teams-root",
            "any": [
              ".teams-container"
            ]
          }
        ],
        "recommended": [
          {
            "name": "sidebar",
            "any": [
              ".conversation-sidebar",
              ".conversation-list"
            ]
          },
          {
            "name": "workspace",
            "any": [
              ".teams-main-content",
              ".main-content",
              ".chat-container"
            ]
          },
          {
            "name": "composer",
            "any": [
              "[role='textbox'][contenteditable='true']",
              ".wb-home-composer [contenteditable='true']"
            ]
          }
        ]
      }
    },
    "doubao": {
      "css": "assets/css/doubao.css",
      "verification": {
        "required": [
          {
            "name": "doubao-root",
            "any": [
              "#root",
              "body"
            ]
          }
        ]
      }
    },
    "codex": {
      "css": "assets/css/codex.css",
      "verification": {
        "required": [
          {
            "name": "codex-root",
            "any": [
              "main.main-surface",
              "main[class*='MainContentSurface']"
            ]
          }
        ],
        "recommended": [
          {
            "name": "sidebar",
            "any": [
              "aside.app-shell-left-panel"
            ]
          },
          {
            "name": "composer",
            "any": [
              ".composer-surface-chrome"
            ]
          }
        ]
      }
    },
    "zcode": {
      "css": "assets/css/zcode.css",
      "verification": {
        "required": [
          {
            "name": "zcode-root",
            "any": [
              "#root",
              "body"
            ]
          }
        ],
        "recommended": [
          {
            "name": "composer",
            "any": [
              "[contenteditable='true']",
              "textarea"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#e8a0b8",
    "secondary": "#c9a0b0",
    "background": "#141014",
    "foreground": "#eadfe4",
    "muted": "#96868e",
    "surface": "#1e181e",
    "surfaceElevated": "#272026",
    "codeBackground": "#0e0b0e",
    "codeForeground": "#d8ccd2",
    "inputBackground": "#221b22",
    "border": "rgba(232, 160, 184, 0.18)",
    "buttonBackground": "rgba(232, 160, 184, 0.14)",
    "buttonForeground": "#e8a0b8",
    "focusRing": "#e8a0b860"
  },
  "colorSchemes": [
    "wisteria",
    "ume"
  ]
}
