{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "deepspace-nebula",
  "name": "Deepspace Nebula",
  "displayName": "Deepspace Nebula",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "dark",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#8b7cf7",
    "secondary": "#c9a0f0",
    "background": "#0b0816",
    "foreground": "#d6cfe8",
    "muted": "#7d7399",
    "surface": "#141026",
    "surfaceElevated": "#1b1630",
    "border": "rgba(139, 124, 247, 0.2)",
    "codeBackground": "#070510",
    "codeForeground": "#c1b8dc",
    "inputBackground": "#181329",
    "buttonBackground": "rgba(139, 124, 247, 0.15)",
    "buttonForeground": "#ffffff",
    "focusRing": "#8b7cf760"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "dark"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
