{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "id": "endland-wasteland",
  "name": "Endland Wasteland",
  "displayName": "终末之地",
  "version": "1.0.0",
  "description": "文明终结后的废土世界。深炭黑底色上漂浮着灰烬，锈红色的余烬点缀其间——像燃烧的文明最后的光。低饱和度、高对比度，适合长时间沉浸式工作。",
  "author": {
    "name": "AgentSkin Team",
    "url": "https://github.com/Heng0128/AgentSkin"
  },
  "mode": "dark",
  "category": "cyberpunk",
  "tags": ["dark", "wasteland", "apocalyptic", "rust", "ash", "ember", "post-apocalyptic"],
  "icon": "icon.png",
  "preview": "preview.png",
  "hero": "assets/hero.png",
  "dynamic": "particles",
  "colors": {
    "accent": "#c44536",
    "secondary": "#d4a574",
    "background": "#0d0d0f",
    "foreground": "#e8e0d5",
    "muted": "#8a7e70",
    "surface": "#1a1a1d",
    "surfaceElevated": "#252529",
    "border": "rgba(196, 69, 54, 0.18)",
    "codeBackground": "#0a0a0c",
    "codeForeground": "#c9bfb0",
    "inputBackground": "#1e1614",
    "buttonBackground": "#c44536",
    "buttonForeground": "#0d0d0f",
    "focusRing": "rgba(196, 69, 54, 0.6)"
  },
  "targets": {
    "traework": { "css": "assets/css/traework.css" },
    "qoderwork": { "css": "assets/css/qoderwork.css" },
    "workbuddy": { "css": "assets/css/workbuddy.css" },
    "doubao": { "css": "assets/css/doubao.css" },
    "codex": { "css": "assets/css/codex.css" },
    "zcode": { "css": "assets/css/zcode.css" }
  },
  "supportedAgents": ["traework", "qoderwork", "workbuddy", "doubao", "codex", "zcode"],
  "license": "MPL-2.0",
  "minAppVersion": "1.0.0"
}
