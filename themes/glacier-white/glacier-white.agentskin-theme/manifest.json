{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "glacier-white",
  "name": "冰川白",
  "displayName": "冰川白",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "light",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#5b8fbf",
    "secondary": "#8a9aa6",
    "background": "#fafbfc",
    "foreground": "#24282c",
    "muted": "#74787c",
    "surface": "#ffffff",
    "surfaceElevated": "#f6f8fa",
    "border": "rgba(40, 42, 54, 0.14)",
    "codeBackground": "#eff1f3",
    "codeForeground": "#34383c",
    "inputBackground": "#f2f4f6",
    "buttonBackground": "rgba(91, 143, 191, 0.16)",
    "buttonForeground": "#1a1a2e",
    "focusRing": "color-mix(in srgb, #5b8fbf 40%, transparent)",
    "selection": "color-mix(in srgb, #5b8fbf 32%, transparent)"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "light"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
