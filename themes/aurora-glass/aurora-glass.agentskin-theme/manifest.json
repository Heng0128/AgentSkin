{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "aurora-glass",
  "name": "Aurora Glass",
  "displayName": "Aurora Glass",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "dark",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#6ee7d3",
    "secondary": "#9b8cff",
    "background": "#0a0e1a",
    "foreground": "#e6ecf5",
    "muted": "#8a96ad",
    "surface": "#121829",
    "surfaceElevated": "#1a2236",
    "border": "rgba(110, 231, 211, 0.18)",
    "codeBackground": "#070b14",
    "codeForeground": "#cdd9e8",
    "inputBackground": "#16203a",
    "buttonBackground": "rgba(110, 231, 211, 0.14)",
    "buttonForeground": "#1a1a2e",
    "focusRing": "#6ee7d360",
    "selection": "color-mix(in srgb, #6ee7d3 32%, transparent)"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "dark"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
