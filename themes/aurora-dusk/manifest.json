{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "id": "aurora-dusk",
  "name": "Aurora Dusk",
  "displayName": "极光黄昏",
  "version": "1.0.0",
  "description": "当极光遇见黄昏——深邃午夜蓝基底上的一抹珊瑚色。冷暖交织的色彩对话，如同极地夜空与落日余晖的交界时刻。表面层次采用渐变冰霜边框模拟极光折射，color-mix 冰川质感。",
  "mode": "dark",
  "targets": {
    "traework":    { "css": "assets/css/traework.css" },
    "qoderwork":   { "css": "assets/css/qoderwork.css" },
    "workbuddy":   { "css": "assets/css/workbuddy.css" },
    "doubao":      { "css": "assets/css/doubao.css" },
    "codex":       { "css": "assets/css/codex.css" },
    "zcode":       { "css": "assets/css/zcode.css" }
  },
  "supportedAgents": ["traework", "qoderwork", "workbuddy", "doubao", "codex", "zcode"],
  "colors": {
    "accent": "#ff7a6b",
    "secondary": "#a8b4e6",
    "background": "#0a0e1a",
    "foreground": "#e8edf5",
    "muted": "#7a859a",
    "surface": "#141b2d",
    "surfaceElevated": "#1c2540",
    "border": "rgba(255, 122, 107, 0.16)",
    "codeBackground": "#0d1220",
    "codeForeground": "#d0d8e8",
    "inputBackground": "#141b2d",
    "buttonBackground": "#ff7a6b",
    "buttonForeground": "#0a0e1a",
    "focusRing": "#ff7a6b8c"
  },
  "colorSchemes": ["aurora-green", "twilight-orange", "glacial-violet"],
  "icon": "icon.png",
  "preview": "preview.png",
  "author": { "name": "AgentSkin Team", "url": "https://github.com/Heng0128/AgentSkin" },
  "category": "dark",
  "tags": ["dark", "aurora", "coral", "midnight", "gradient"],
  "license": "MPL-2.0",
  "probe": {
    "tokenNamespaces": ["--agentskin-", "--vscode-", "--color-", "--cb-", "--semi-color-"],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
