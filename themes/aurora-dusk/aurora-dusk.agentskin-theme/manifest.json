{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "aurora-dusk",
  "name": "Aurora Dusk",
  "displayName": "Aurora Dusk",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "dark",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#ff7a6b",
    "secondary": "#a8b4e6",
    "background": "#0a0e1a",
    "foreground": "#e8edf5",
    "muted": "#7a859a",
    "surface": "#141b2d",
    "surfaceElevated": "#1c2540",
    "border": "rgba(255, 122, 107, 0.16)",
    "codeBackground": "#0d1220",
    "codeForeground": "#d0d8e8",
    "inputBackground": "#141b2d",
    "buttonBackground": "#ff7a6b",
    "buttonForeground": "#1a1a2e",
    "focusRing": "#ff7a6b8c",
    "selection": "color-mix(in srgb, #ff7a6b 32%, transparent)"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "dark"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
