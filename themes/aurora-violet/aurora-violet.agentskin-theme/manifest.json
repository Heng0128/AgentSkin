{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "aurora-violet",
  "name": "Aurora Violet",
  "displayName": "Aurora Violet",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "dark",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#a98fe8",
    "secondary": "#94a0d9",
    "background": "#0e0a18",
    "foreground": "#e2def0",
    "muted": "#847f9c",
    "surface": "#161226",
    "surfaceElevated": "#1e1831",
    "border": "rgba(169, 143, 232, 0.18)",
    "codeBackground": "#090710",
    "codeForeground": "#cfcadd",
    "inputBackground": "#191429",
    "buttonBackground": "rgba(169, 143, 232, 0.14)",
    "buttonForeground": "#ffffff",
    "focusRing": "#a98fe860"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "dark"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
