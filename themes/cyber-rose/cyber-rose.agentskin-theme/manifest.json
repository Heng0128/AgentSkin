{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "cyber-rose",
  "name": "Cyber Rose",
  "displayName": "Cyber Rose",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "dark",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#e87fa8",
    "secondary": "#b88fc0",
    "background": "#120e14",
    "foreground": "#e8dee4",
    "muted": "#927f8c",
    "surface": "#1b1520",
    "surfaceElevated": "#241c2a",
    "border": "rgba(232, 127, 168, 0.18)",
    "codeBackground": "#0d0a10",
    "codeForeground": "#d6cad2",
    "inputBackground": "#1f1824",
    "buttonBackground": "rgba(232, 127, 168, 0.14)",
    "buttonForeground": "#ffffff",
    "focusRing": "#e87fa860"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "dark"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
