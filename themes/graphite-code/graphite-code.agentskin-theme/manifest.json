{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "graphite-code",
  "name": "石墨工坊",
  "displayName": "石墨工坊",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "light",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#5b7a99",
    "secondary": "#7a8a96",
    "background": "#f4f5f6",
    "foreground": "#26292e",
    "muted": "#71767d",
    "surface": "#ffffff",
    "surfaceElevated": "#fafbfc",
    "border": "rgba(40, 42, 54, 0.14)",
    "codeBackground": "#eaecef",
    "codeForeground": "#363a40",
    "inputBackground": "#f0f2f4",
    "buttonBackground": "rgba(91, 122, 153, 0.16)",
    "buttonForeground": "#1a1a2e",
    "focusRing": "color-mix(in srgb, #5b7a99 40%, transparent)",
    "selection": "color-mix(in srgb, #5b7a99 32%, transparent)"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "light"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
