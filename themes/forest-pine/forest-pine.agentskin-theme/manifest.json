{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "forest-pine",
  "name": "松林雾霭",
  "displayName": "松林雾霭",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "dark",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#8fbf9f",
    "secondary": "#a3b8a0",
    "background": "#0d1512",
    "foreground": "#d5e2d8",
    "muted": "#7d8f82",
    "surface": "#14201b",
    "surfaceElevated": "#1b2a23",
    "border": "rgba(143, 191, 159, 0.18)",
    "codeBackground": "#080f0c",
    "codeForeground": "#c2d4c6",
    "inputBackground": "#16241e",
    "buttonBackground": "rgba(143, 191, 159, 0.14)",
    "buttonForeground": "#1a1a2e",
    "focusRing": "color-mix(in srgb, #8fbf9f 40%, transparent)",
    "selection": "color-mix(in srgb, #8fbf9f 32%, transparent)"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "dark"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
