{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "id": "void-donut-boy",
  "name": "void-donut-boy",
  "displayName": "Void Donut Boy",
  "version": "2.0.0",
  "description": "Pale boy clutching a pink donut in a dim room lit by a laptop screen.",
  "author": {
    "name": "Auto-generated"
  },
  "mode": "dark",
  "category": "photo",
  "tags": [
    "dark",
    "photo",
    "anime",
    "monochrome",
    "horror"
  ],
  "icon": "icon.webp",
  "preview": "preview.webp",
  "colors": {
    "accent": "#d7ecc4",
    "secondary": "#dff0d0",
    "background": "#020201",
    "foreground": "#f4f0eb",
    "muted": "#cbc9c6",
    "surface": "#161615",
    "surfaceElevated": "#252525",
    "border": "#1b1b1a",
    "codeBackground": "#020201",
    "codeForeground": "#f4f0eb",
