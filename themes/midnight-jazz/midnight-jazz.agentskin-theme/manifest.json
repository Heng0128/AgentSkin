{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "midnight-jazz",
  "name": "午夜爵士",
  "displayName": "午夜爵士",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "dark",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#d9a26b",
    "secondary": "#b09078",
    "background": "#0e1016",
    "foreground": "#e4e0d8",
    "muted": "#8b877f",
    "surface": "#151823",
    "surfaceElevated": "#1c202e",
    "border": "rgba(217, 162, 107, 0.18)",
    "codeBackground": "#090b10",
    "codeForeground": "#d0ccc2",
    "inputBackground": "#181c29",
    "buttonBackground": "rgba(217, 162, 107, 0.14)",
    "buttonForeground": "#1a1a2e",
    "focusRing": "color-mix(in srgb, #d9a26b 40%, transparent)",
    "selection": "color-mix(in srgb, #d9a26b 32%, transparent)"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "dark"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
