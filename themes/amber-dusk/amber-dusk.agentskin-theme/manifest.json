{
  "$schema": "https://agentskin.dev/schema/manifest-v2.json",
  "schemaVersion": 2,
  "format": "agentskin-theme",
  "id": "amber-dusk",
  "name": "Amber Dusk",
  "displayName": "Amber Dusk",
  "version": "1.0.0",
  "description": "由 AgentSkin 工作室导出（traework）",
  "author": {
    "name": "AgentSkin Team"
  },
  "mode": "dark",
  "targets": {
    "traework": {
      "css": "assets/css/traework.css",
      "verification": {
        "required": [
          {
            "name": "solo-shell",
            "any": [
              ".panel-container",
              ".solo-lite-layout"
            ]
          }
        ]
      }
    }
  },
  "colors": {
    "accent": "#d9a26b",
    "secondary": "#bfa07f",
    "background": "#161210",
    "foreground": "#e8ddd0",
    "muted": "#96887a",
    "surface": "#201a16",
    "surfaceElevated": "#29211b",
    "border": "rgba(217, 162, 107, 0.18)",
    "codeBackground": "#0f0c0a",
    "codeForeground": "#d8cbb8",
    "inputBackground": "#241d18",
    "buttonBackground": "rgba(217, 162, 107, 0.14)",
    "buttonForeground": "#ffffff",
    "focusRing": "#d9a26b60"
  },
  "preview": "preview.png",
  "icon": "icon.png",
  "category": "studio",
  "tags": [
    "studio",
    "custom",
    "dark"
  ],
  "unofficial": true,
  "supportedAgents": [
    "traework"
  ],
  "probe": {
    "tokenNamespaces": [
      "--agentskin-",
      "--cb-",
      "--vscode-",
      "--color-",
      "--dbx-",
      "--wb-",
      "--text-"
    ],
    "styleContract": "THEME_SPEC.md#探针样式契约"
  }
}
